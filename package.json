  },
  "dependencies": {
    "markdown-it-footnote": "4.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,md,vue,yaml,yml,json}": "prettier --write"
  }
}
